ARG ATHENA_BASE_IMAGE=athena-preview:local
FROM node:24-bookworm-slim AS browser
RUN npm install --prefix /runtime agent-browser@0.38.2

FROM ghcr.io/astral-sh/uv:0.9.30-bookworm-slim AS worker
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates curl git unzip fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* \
    && uv python install 3.14t && uv venv --python 3.14t /opt/venv \
    && uv pip install --python /opt/venv/bin/python openpyxl==3.1.5 pypdf==6.1.1 \
    && /usr/sbin/useradd --uid 10001 --create-home athena
COPY --from=browser /runtime/node_modules/agent-browser/bin/agent-browser-linux-x64 /usr/local/bin/agent-browser
USER 10001:10001
WORKDIR /tmp
# This image contains tools, never Athena source, account data, or provider keys.
CMD ["/bin/sh"]

FROM docker:29.6.1-cli AS dockercli
FROM ${ATHENA_BASE_IMAGE} AS broker
USER root
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
ENTRYPOINT ["/opt/venv/bin/python", "-m", "athena.execution_broker"]
