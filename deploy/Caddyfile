{
    auto_https disable_redirects
    servers {
        max_header_size 16KB
    }
}
(athena_https) {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
}
chat.athena.featherhk.com {
    import athena_https
    request_body {
        max_size 40MB
    }
    @credentials path /api/auth/* /api/account/password /v1/auth/* /v1/account/password
    request_body @credentials {
        max_size 16KB
    }
    handle /v1/* {
        reverse_proxy gateway:4321 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy web:4317 {
            flush_interval -1
        }
    }
}
app.athena.featherhk.com {
    import athena_https
    handle_path /downloads/* {
        root * /srv/downloads
        file_server
    }
    @shared path /css/* /js/* /assets/* /release.json
    handle @shared {
        root * /srv/site
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        root * /srv/site/app
        header Cache-Control "no-cache"
        file_server
    }
}
featherhk.com {
    import athena_https
    root * /srv/site
    header Cache-Control "no-cache"
    file_server
}
www.featherhk.com {
    import athena_https
    redir https://featherhk.com{uri} permanent
}
