{
  "sourceLanguage": "en",
  "strings": {
    "starting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ فتح أثينا…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Athena…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriendo Athena…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture d’Athena…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena を開いています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena를 여는 중…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrindo o Athena…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开 Athena…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟 Athena…"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر الاتصال بأثينا الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena can’t connect right now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena no puede conectarse ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena ne peut pas se connecter pour le moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 Athena に接続できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Athena에 연결할 수 없어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Athena não consegue se conectar agora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法连接 Athena"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法連線至 Athena"
          }
        }
      }
    },
    "connection_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اتصالك ثم أعد المحاولة. تبقى محادثاتك محفوظة في حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Your conversations remain in your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo. Tus conversaciones siguen guardadas en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Vos conversations restent dans votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。会話はアカウントに保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인하고 다시 시도하세요. 대화는 계정에 저장되어 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão e tente novamente. Suas conversas continuam salvas na sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络后重试。你的会话仍保存在账户中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路後重試。你的對話仍保存在帳戶中。"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "reload_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تحميل الصفحة قد تفقد النص غير المُرسل. لن تعيد تشغيل المهام الجارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloading may discard unsent text. It will not restart work already running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al recargar se puede perder el texto sin enviar. Las tareas en curso no se reiniciarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rechargement peut supprimer le texte non envoyé. Il ne relance pas les tâches en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込みすると未送信の文章が失われる場合があります。実行中のタスクを最初からやり直すことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침하면 보내지 않은 글이 사라질 수 있어요. 진행 중인 작업을 처음부터 다시 실행하지는 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregar pode descartar o texto não enviado. As tarefas em andamento não serão reiniciadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载可能丢失尚未发送的文字，不会重新执行已经开始的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入可能遺失尚未傳送的文字，不會重新執行已經開始的任務。"
          }
        }
      }
    },
    "download_failed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل الملف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t download this file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger ce fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをダウンロードできませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 다운로드하지 못했어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar este arquivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件下载失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案下載失敗"
          }
        }
      }
    },
    "download_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف الأصلي ما زال في المحادثة. يمكنك المحاولة مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is still in your conversation. You can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original sigue en tu conversación. Puedes volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier original est toujours dans votre conversation. Vous pouvez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルは会話に残っています。もう一度お試しいただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 대화에 남아 있어요. 다시 시도할 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original continua na conversa. Você pode tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件仍保留在会话中，可以稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始檔案仍保留在對話中，可以稍後重試。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
