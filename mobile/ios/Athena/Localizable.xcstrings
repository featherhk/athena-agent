{
  "sourceLanguage": "en",
  "strings": {
    "starting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ فتح أثينا…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Athena…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriendo Athena…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture d’Athena…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena を開いています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena를 여는 중…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrindo o Athena…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开 Athena…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟 Athena…"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر الاتصال بأثينا الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena can’t connect right now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena no puede conectarse ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena ne peut pas se connecter pour le moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 Athena に接続できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Athena에 연결할 수 없어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Athena não consegue se conectar agora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法连接 Athena"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法連線至 Athena"
          }
        }
      }
    },
    "connection_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اتصالك ثم أعد المحاولة. تبقى محادثاتك محفوظة في حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. Your conversations remain in your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo. Tus conversaciones siguen guardadas en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Vos conversations restent dans votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。会話はアカウントに保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인하고 다시 시도하세요. 대화는 계정에 저장되어 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão e tente novamente. Suas conversas continuam salvas na sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络后重试。你的会话仍保存在账户中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路後重試。你的對話仍保存在帳戶中。"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "reload_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الواجهة الافتراضية دون الواجهات المخصصة. قد تفقد النص غير المُرسل. لن تُحذف المحادثات أو الملفات ولن تُعاد المهام الجارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the default interface without custom surfaces. Unsent text may be lost. Chats and files stay; running work will not restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la interfaz predeterminada sin interfaces personalizadas. Puede perderse el texto sin enviar. Los chats y archivos se conservan; las tareas en curso no se reinician."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir l’interface par défaut sans interfaces personnalisées. Le texte non envoyé peut être perdu. Les conversations et fichiers sont conservés, sans relancer les tâches en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム画面を読み込まずに標準画面を開きます。未送信の文章は失われる場合があります。会話とファイルは保持され、実行中のタスクを最初からやり直すことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 화면 없이 기본 화면을 엽니다. 보내지 않은 글은 사라질 수 있어요. 대화와 파일은 보존되며 진행 중인 작업을 처음부터 다시 실행하지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a interface padrão sem interfaces personalizadas. O texto não enviado pode ser perdido. Conversas e arquivos ficam salvos; as tarefas em andamento não serão reiniciadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用默认界面打开，暂不加载自定义界面。尚未发送的文字可能丢失；聊天和文件会保留，进行中的任务不会重新执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以預設介面開啟，暫不載入自訂介面。尚未傳送的文字可能遺失；對話和檔案會保留，進行中的任務不會重新執行。"
          }
        }
      }
    },
    "download_failed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل الملف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t download this file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger ce fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをダウンロードできませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 다운로드하지 못했어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar este arquivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件下载失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案下載失敗"
          }
        }
      }
    },
    "download_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف الأصلي ما زال في المحادثة. يمكنك المحاولة مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is still in your conversation. You can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original sigue en tu conversación. Puedes volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier original est toujours dans votre conversation. Vous pouvez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルは会話に残っています。もう一度お試しいただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 대화에 남아 있어요. 다시 시도할 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original continua na conversa. Você pode tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件仍保留在会话中，可以稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始檔案仍保留在對話中，可以稍後重試。"
          }
        }
      }
    },
    "recover_page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة واجهة أثينا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover Athena"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar Athena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer Athena"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena を復旧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena 복구"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar o Athena"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复 Athena"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原 Athena"
          }
        }
      }
    },
    "navigation_failed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذه الصفحة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open this page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esta página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir cette page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを開けませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지를 열 수 없어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esta página"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开这个页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟此頁面"
          }
        }
      }
    },
    "navigation_detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك متابعة المحادثة. بقي النص غير المُرسل كما هو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep using this conversation. Your unsent text is still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir usando esta conversación. El texto sin enviar sigue aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer cette conversation. Votre texte non envoyé est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は引き続き利用できます。未送信の文章も残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화를 계속 사용할 수 있어요. 보내지 않은 글도 그대로 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar nesta conversa. Seu texto não enviado continua aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以继续使用当前会话，尚未发送的文字仍保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以繼續使用目前的對話，尚未傳送的文字仍保留在這裡。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
