{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الميكروفون عند بدء محادثة صوتية مع أثينا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your microphone when you start a voice conversation with Athena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el micrófono cuando inicies una conversación de voz con Athena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le microphone lorsque vous démarrez une conversation vocale avec Athena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena との音声会話を開始するときにマイクを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena와 음성 대화를 시작할 때 마이크를 사용해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o microfone ao iniciar uma conversa por voz com o Athena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始与 Athena 语音交谈时使用麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始與 Athena 語音交談時使用麥克風。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة لمشاركتها مع أثينا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo to share with Athena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto para compartir con Athena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo à partager avec Athena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena に共有する写真を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Athena에 공유할 사진을 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto para compartilhar com o Athena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要分享给 Athena 的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要分享給 Athena 的照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
