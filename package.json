{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"uv run --directory backend python -m athena\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/generate-third-party-notices.mjs",
    "start": "uv run --directory backend python -m athena",
    "test": "uv run pytest && node --experimental-strip-types --test tests/*.test.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check": "npm run check:repo && npm test && npm run build",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "agent-browser": "0.38.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.5",
    "happy-dom": "20.14.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
