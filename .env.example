# Operator-only configuration. Prefer the admin CLI and the external database.
# Never distribute a platform credential in a client or commit it to this repository.
DEEPSEEK_API_KEY=
# Optional: defaults to the OS application-data directory, outside this repository.
# ATHENA_DATA_DIR=/absolute/path/outside/this/repository
# ATHENA_PORT=4317

# Optional operator-only audio service. Keep the key file outside the checkout.
# ATHENA_AUDIO_PROVIDER=dashscope
# ATHENA_AUDIO_API_KEY_FILE=/private/operator/path/audio-key.txt
# ATHENA_AUDIO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# ATHENA_AUDIO_STT_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ATHENA_AUDIO_STT_MODEL=qwen3-asr-flash
# ATHENA_AUDIO_TTS_MODEL=qwen3-tts-flash
# ATHENA_AUDIO_VOICE=Cherry
# Hosted audio remains disabled until reviewed USD tariff values are set.
# ATHENA_AUDIO_STT_USD_PER_SECOND=
# ATHENA_AUDIO_TTS_USD_PER_10K_CHARACTERS=

# Cloud operator configuration; see docs/cloud-deployment.md.
# These names must be explicitly passed to the relevant container. Merely placing
# them in this file or the host shell does not override deploy/compose.yaml.
# Gateway only (never distribute provider-key files with desktop/web clients):
# ATHENA_GATEWAY_DATA_DIR=/absolute/private/path/accounts
# ATHENA_GATEWAY_KEY_FILE=/absolute/private/path/model-key
# ATHENA_GATEWAY_PROVIDER_URL=https://api.deepseek.com
# ATHENA_GATEWAY_MODEL=deepseek-flash
# Text credit tariffs are GatewayConfig fields, not environment settings yet.
# Web worker / desktop sidecar (central identity and metered model access):
# ATHENA_CLOUD_URL=https://app.featherhk.com/v1
# Hosted web only; local desktop keeps its loopback origin:
# ATHENA_PUBLIC_ORIGIN=https://app.featherhk.com
# ATHENA_DEPLOYMENT=hosted
